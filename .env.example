DEEPSEEK_API_KEY=your_deepseek_api_key
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_IMAGE_MODEL=wanx2.0-t2i-turbo
DASHSCOPE_IMAGE_SIZE=1024*1024
DASHSCOPE_POLL_INTERVAL=10
DASHSCOPE_MAX_POLLS=12

# Accepted requests, including upstream failures; daily reset at 00:00 UTC.
CHAT_PER_MINUTE=12
IMAGE_PER_MINUTE=4
CHAT_DAILY_LIMIT=600
IMAGE_DAILY_LIMIT=120
CHAT_CONCURRENCY=8
IMAGE_CONCURRENCY=3
# Keep this directory persistent across deploys/restarts.
LIMITS_DB_PATH=.state/request_limits.sqlite3

# Comma-separated exact reverse-proxy peer IPs; empty means no forwarded-header trust.
TRUSTED_PROXY_IPS=
